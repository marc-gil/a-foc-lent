---
import type { CollectionEntry } from "astro:content";
import { formatDurationHHMM } from "../../lib/duration";

interface Props {
  recipe: CollectionEntry<"recipes">;
}

const { data: recipeData } = Astro.props.recipe;
---

<article>
  <time datetime={recipeData.duration}>
    {formatDurationHHMM(recipeData.duration)}
  </time>
  <h2>
    <a href={`/a-foc-lent/recipes/${Astro.props.recipe.id}/`}>
      {recipeData.title}
    </a>
  </h2>
  <footer>
    <span data-category={recipeData.category} class="category">
      {recipeData.category}
    </span>
    <span data-difficulty={recipeData.difficulty} class="difficulty">
      {recipeData.difficulty}
    </span>
  </footer>
</article>

<style>
  article {
    position: relative;
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0px 20px;
  }

  time {
    align-items: center;
    justify-content: center;
    align-content: center;
    font-size: 16px;

    @media (width <= 850px) {
      font-size: 15px;
    }
  }

  h2 {
    font-weight: 500;
    font-size: 20px;

    @media (width <= 850px) {
      font-size: 16px;
    }
  }

  a::after {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    content: " ";
  }

  span {
    font-size: 16px;

    @media (width <= 850px) {
      font-size: 15px;
    }
  }

  footer {
    grid-column: 2;
    grid-row: 2;
  }

  span + span {
    margin-left: 20px;
  }
</style>
