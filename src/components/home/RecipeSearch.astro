---
import SearchInput from "../../components/home/SearchInput.astro";
import CategorySearch from "./search/CategorySearch.astro";

interface Props {
  filters: string[];
  showSearchIcon?: boolean;
  theme?: string;
}

const { filters, showSearchIcon = true } = Astro.props;
---

<search>
  <SearchInput showIcon={showSearchIcon} />
  <CategorySearch categories={filters} />
  <div class="filter-bar">
    <div class="active-filters" role="group">
      <button id="filters-toggle" type="button" aria-expanded="false" aria-controls="recipe-filters">Filtres</button>
      <ul aria-label="Filtres actius">
        <li data-filter="time" data-value="15">
          <button type="button" aria-label="Elimina el filtre de temps: 15 minuts o menys">
            15' <span aria-hidden="true">×</span>
          </button>
        </li>
        <li data-filter="time" data-value="30">
          <button type="button" aria-label="Elimina el filtre de temps: 30 minuts o menys">
            30' <span aria-hidden="true">×</span>
          </button>
        </li>
        <li data-filter="time" data-value="60">
          <button type="button" aria-label="Elimina el filtre de temps: 60 minuts o menys">
            1H <span aria-hidden="true">×</span>
          </button>
        </li>
        <li data-filter="time" data-value="60+">
          <button type="button" aria-label="Elimina el filtre de temps: 60 minuts o més">
            1H+ <span aria-hidden="true">×</span>
          </button>
        </li>
        <li data-filter="difficulty" data-value="easy">
          <button type="button" aria-label="Elimina el filtre de nivell de dificultat: Facil">
            Facil <span aria-hidden="true">×</span>
          </button>
        </li>
        <li data-filter="difficulty" data-value="medium">
          <button type="button" aria-label="Elimina el filtre de nivell de dificultat: Intermedi">
            Intermedi <span aria-hidden="true">×</span>
          </button>
        </li>
        <li data-filter="difficulty" data-value="hard">
          <button type="button" aria-label="Elimina el filtre de nivell de dificultat: Dificil">
            Dificil <span aria-hidden="true">×</span>
          </button>
        </li>
      </ul>
    </div>
    <div id="recipe-filters">
      <fieldset>
        <legend>Temps</legend>
        <ul>
          <li>
            <input type="radio" name="recipe-time" id="time-any" value="" checked />
            <label for="time-any">Qualsevol</label>
          </li>
          <li>
            <input type="radio" name="recipe-time" id="time-15" value="15" />
            <label for="time-15">15' o menys</label>
          </li>
          <li>
            <input type="radio" name="recipe-time" id="time-30" value="30" />
            <label for="time-30">30' o menys</label>
          </li>
          <li>
            <input type="radio" name="recipe-time" id="time-60" value="60" />
            <label for="time-60">1h o menys</label>
          </li>
          <li>
            <input type="radio" name="recipe-time" id="time-60+" value="60+" />
            <label for="time-60+">Més d'1h</label>
          </li>
        </ul>
      </fieldset>
      <fieldset>
        <legend>Dificultat</legend>
        <ul>
          <li>
            <input type="radio" name="recipe-difficulty" id="difficulty-any" value="" checked />
            <label for="difficulty-any">Qualsevol</label>
          </li>
          <li>
            <input type="radio" name="recipe-difficulty" id="difficulty-easy" value="easy" />
            <label for="difficulty-easy">Facil</label>
          </li>
          <li>
            <input type="radio" name="recipe-difficulty" id="difficulty-medium" value="medium" />
            <label for="difficulty-medium">Intermedi</label>
          </li>
          <li>
            <input type="radio" name="recipe-difficulty" id="difficulty-hard" value="hard" />
            <label for="difficulty-hard">Dificil</label>
          </li>
        </ul>
      </fieldset>
    </div>
  </div>
</search>

<script>
  const timeRadioButtons = document.querySelectorAll("input[name='recipe-time']");
  timeRadioButtons.forEach((timeRadioButton) => {
    timeRadioButton.addEventListener("change", (e) => {
      const target = e.target as HTMLInputElement;
      const event = new CustomEvent("time-changed", {
        bubbles: true,
        detail: { time: target.value },
      });
      target.dispatchEvent(event);
    });
  });

  const difficultyRadioButtons = document.querySelectorAll("input[name='recipe-difficulty']");
  difficultyRadioButtons.forEach((difficultyRadioButton) => {
    difficultyRadioButton.addEventListener("change", (e) => {
      const target = e.target as HTMLInputElement;
      const event = new CustomEvent("difficulty-changed", {
        bubbles: true,
        detail: { difficulty: target.value },
      });
      target.dispatchEvent(event);
    });
  });

  const filtersToggleButton: HTMLButtonElement = document.querySelector("#filters-toggle")!;
  filtersToggleButton.addEventListener("click", () => {
    const isExpanded = filtersToggleButton.getAttribute("aria-expanded") === "true";

    filtersToggleButton.setAttribute("aria-expanded", String(!isExpanded));
  });

  //Quan eliminem els filters desde els labels simulem el click de qualsevol
  document.querySelectorAll<HTMLElement>(".active-filters li[data-filter] button").forEach((btn) => {
    btn.addEventListener("click", () => {
      const { filter } = btn.closest<HTMLElement>("li")!.dataset;
      document.querySelector<HTMLInputElement>(`#${filter}-any`)!.click();
    });
  });
</script>

<style>
  search {
    display: flex;
    flex-direction: column;
  }

  .filter-bar:has(#filters-toggle[aria-expanded="false"]) #recipe-filters {
    display: none;
    opacity: 0;
    transform: translateY(-10px) scaleY(0.96);
  }

  #recipe-filters {
    display: block;
    opacity: 1;
    transform: none;
    transform-origin: top center;
    transition:
      opacity 250ms ease,
      transform 250ms ease,
      display 250ms allow-discrete;
  }

  @starting-style {
    #recipe-filters {
      opacity: 0;
      transform: translateY(-10px) scaleY(0.96);
    }
  }

  legend {
    float: left;
    margin-bottom: 8px;
  }

  button {
    color: inherit;
    padding: 6px 0;
  }

  #filters-toggle::before {
    content: "+ ";
  }

  #filters-toggle[aria-expanded="true"]::before {
    content: "- ";
  }

  fieldset {
    display: flex;
    flex-direction: column;
    min-width: 0;
    margin-bottom: 8px;
  }

  fieldset > ul {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  fieldset > ul > li {
    display: flex;
    align-items: center;
  }

  input[type="radio"] {
    appearance: none;
  }

  .active-filters {
    display: flex;
    justify-content: space-between;
  }

  .active-filters ul {
    display: flex;
    flex-direction: row;
    gap: 20px;
  }

  .active-filters li {
    display: none;
  }

  .active-filters > ul > li > button {
    background-color: #d2d2d2;
    box-shadow:
      -0.5ch 0 #d2d2d2,
      0.5ch 0 #d2d2d2;
  }

  .active-filters > ul > li > button:hover {
    text-decoration: line-through solid currentColor 1px;
  }

  /* Amaga el ul quan no hi ha filter seleccionat*/
  .filter-bar:has(#time-any:checked):has(#difficulty-any:checked) .active-filters ul {
    display: none;
  }

  .filter-bar:has(#time-15:checked) .active-filters li[data-filter="time"][data-value="15"],
  .filter-bar:has(#time-30:checked) .active-filters li[data-filter="time"][data-value="30"],
  .filter-bar:has(#time-60:checked) .active-filters li[data-filter="time"][data-value="60"],
  .filter-bar:has(#time-60\+:checked) .active-filters li[data-filter="time"][data-value="60+"],
  .filter-bar:has(#difficulty-easy:checked) .active-filters li[data-filter="difficulty"][data-value="easy"],
  .filter-bar:has(#difficulty-medium:checked) .active-filters li[data-filter="difficulty"][data-value="medium"],
  .filter-bar:has(#difficulty-hard:checked) .active-filters li[data-filter="difficulty"][data-value="hard"] {
    display: block;
  }

  :global([data-theme="minimal"]) input[type="radio"]::before {
    content: "( ) ";
    white-space: pre;
    word-wrap: normal; /*Fix for ios to maintain pre*/
  }

  :global([data-theme="minimal"]) input[type="radio"]:checked:before {
    background: radial-gradient(circle closest-side, currentColor 82%, #0000 88%) 1ch 55% / 1ch 0.62em no-repeat;
  }

  :global([data-theme="minimal"]) label {
    background-color: transparent;
    font-weight: 500;
    padding: 8px 10px;

    @media (width <= 850px) {
      padding: 4px 6px;
    }
  }

  :global([data-theme="minimal"]) button {
    font-size: 16px;
  }

  :global([data-theme="minimal"]) .filter-bar::after,
  :global([data-theme="minimal"]) .filter-bar::before {
    margin-top: 0px;
    margin-bottom: 1px;
    display: block;
    height: 16px;
    content: var(--dash);
    overflow: hidden;
    letter-spacing: 2px;
    white-space: nowrap;
  }

  :global([data-theme="minimal"]) legend::before {
    margin-top: 0px;
    margin-bottom: 4px;
    display: block;
    height: 16px;
    content: var(--spaced-dash);
    overflow: hidden;
    letter-spacing: 2px;
    white-space: nowrap;
  }

  :global([data-theme="ticket"]) fieldset:first-of-type {
    padding-top: 16px;
  }

  :global([data-theme="ticket"]) fieldset:last-of-type {
    padding-bottom: 16px;
  }

  :global([data-theme="ticket"]) label {
    border-radius: 4px;
    padding: 11px 14px 10px;
    border: 1px solid rgb(53 59 65);
    background-color: rgb(29 32 35);
    color: rgb(169 174 180);
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 0.78px;
    font-family: ui-monospace, monospace;
  }

  :global([data-theme="ticket"]) input:checked + label {
    background-color: #f3efe6;
    border-color: #f3efe6;
    color: rgb(26 25 24);
  }
</style>
