---
import SearchIcon from "../icons/Search.astro";

interface Props {
  showIcon: boolean;
}

const { showIcon } = Astro.props;
---

<label for="recipe-search" class="visually-hidden">Search recipes</label>
<div class="search-box">
  {showIcon && <SearchIcon />}
  <input id="recipe-search" type="search" placeholder="Busca aqui..." />
</div>

<script>
  const searchInput = document.getElementById("recipe-search");
  searchInput?.addEventListener("input", (e) => {
    const target = e.target as HTMLInputElement;
    target.dispatchEvent(
      new CustomEvent("search-input-changed", {
        bubbles: true,
        detail: {
          search: target.value,
        },
      }),
    );
  });
</script>

<style>
  input {
    margin-left: 4px;
    padding: 8px;
    border: none;
    width: 100%;
    outline: none;
    font-size: large;
  }

  input[type="search"] {
    background-color: transparent;
  }

  .search-box {
    padding: 8px 18px;
    display: flex;
    flex-direction: row;
    align-items: center;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);

    @media (width <= 850px) {
      padding: 6px 12px;
    }
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    white-space: nowrap;
    border: 0;
  }

  :global([data-theme="classic"]) {
    .search-box {
      border-radius: 32px;
      background-color: #fff;
    }
  }

  :global([data-theme="minimal"]) {
    input[type="search"]::placeholder {
      color: #4a4a4a;
      font-weight: 500;
    }

    input[type="search"] {
      font-size: 18px;

      @media (width <= 850px) {
        font-size: 16px;
      }
    }

    .search-box {
      background-color: #d2d2d2;

      @media (width <= 850px) {
        padding: 4px 10px;
      }
    }

    .search-box:has(input:focus-visible) {
      box-shadow: inset 0 -2px 0 #111;
    }
  }

  :global([data-theme="ticket"]) {
    input[type="search"]::placeholder {
      color: currentColor;
      font-family: inherit;
      font-weight: 500;
    }

    input[type="search"] {
      font-size: 18px;
      font-family: ui-monospace, monospace;
      letter-spacing: 0.39px;

      @media (width <= 850px) {
        font-size: 14px;
      }
    }

    .search-box {
      color: rgb(169 174 180);
      background:
        repeating-linear-gradient(
          90deg,
          rgb(255 255 255 / 0.014) 0 1px,
          transparent 1px 3px
        ),
        rgb(21, 23, 25);
      border: 1px solid rgb(53, 59, 65);
      background: #0d0f10;
      box-shadow: inset 0 2px 6px rgb(0 0 0 / 0.5);
      border-radius: 6px;
      font-family: ui-monospace, monospace;
      
      @media (width <= 850px) {
        padding: 4px 10px;
      }
    }

    .search-box:has(input:focus-visible) {
      outline: 2px solid #e8432f;
      outline-offset: 1px;
    }
  }
</style>
