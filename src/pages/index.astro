---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import RecipeSearch from "../components/home/RecipeSearch.astro";
import RecipeCard from "../components/home/RecipeCardMinimal.astro";

const recipes = await getCollection("recipes");

const filters = [...new Set(recipes.map((recipe) => recipe.data.category))];
---

<Layout title="El meu receptari personal" theme="minimal">
  <main>
    <header>
      <h1>Receptari personal</h1>
    </header>
    <hr />
    <RecipeSearch filters={filters} showSearchIcon={false} />
    <ul>
      {
        recipes.map((recipe) => (
          <li
            data-card
            data-difficulty={recipe.data.difficulty}
            data-duration={recipe.data.duration}
            data-category={recipe.data.category}
            data-title={recipe.data.title}
            data-tags={recipe.data.tags}
          >
            <RecipeCard recipe={recipe} />
          </li>
        ))
      }
    </ul>
  </main>
</Layout>

<script>
  let searchInput: string = "";
  let selectedCategory: string = "";
  let selectedTimeComparison: (timeToCompare: string) => boolean = () => true;
  let selectedDifficultyComparison: (difficultyToCompare: string) => boolean = () => true;

  const TIME_COMPARATORS: Record<string, (timeToCompare: string) => boolean> = {
    "15": (timeToCompare: string) => Temporal.Duration.compare(timeToCompare, "PT15M") <= 0,
    "30": (timeToCompare: string) => Temporal.Duration.compare(timeToCompare, "PT30M") <= 0,
    "60": (timeToCompare: string) => Temporal.Duration.compare(timeToCompare, "PT1H") <= 0,
    "60+": (timeToCompare: string) => Temporal.Duration.compare(timeToCompare, "PT1H") > 0,
  };

  const DIFFICULTY_COMPARATORS: Record<string, (difficultyToCompare: string) => boolean> = {
    hard: (difficultyToCompare: string) => difficultyToCompare == "Dificil",
    medium: (difficultyToCompare: string) => difficultyToCompare == "Intermedi",
    easy: (difficultyToCompare: string) => difficultyToCompare == "Facil",
  };

  const recipeCards: NodeListOf<HTMLLIElement> = document.querySelectorAll("[data-card]");

  document.addEventListener("filter-changed", (e) => {
    selectedCategory = (e as CustomEvent<{ filter: string }>).detail.filter;

    recipeCards.forEach((recipeCard) => applyFilters(recipeCard));
  });

  document.addEventListener("search-input-changed", (e) => {
    searchInput = (e as CustomEvent<{ search: string }>).detail.search.toLowerCase();

    recipeCards.forEach((recipeCard) => applyFilters(recipeCard));
  });

  document.addEventListener("time-changed", (e) => {
    const receivedTime = (e as CustomEvent<{ time: string }>).detail.time;

    selectedTimeComparison = TIME_COMPARATORS[receivedTime] ?? (() => true);

    recipeCards.forEach((recipeCard) => applyFilters(recipeCard));
  });

  document.addEventListener("difficulty-changed", (e) => {
    const receivedDifficulty = (e as CustomEvent<{ difficulty: string }>).detail.difficulty;

    selectedDifficultyComparison = DIFFICULTY_COMPARATORS[receivedDifficulty] ?? (() => true);

    recipeCards.forEach((recipeCard) => applyFilters(recipeCard));
  });

  function applyFilters(recipeCard: HTMLLIElement) {
    const {title, category, duration, difficulty} = recipeCard.dataset;

    const textMatches = title!.includes(searchInput) || searchInput == "";

    const categoryMatches = selectedCategory === "" || category === selectedCategory;

    const difficultyMatches = selectedDifficultyComparison(difficulty!);

    const timeMatches = selectedTimeComparison(duration!);

    recipeCard.hidden = textMatches && categoryMatches && difficultyMatches && timeMatches ? false : true;
  }
</script>

<style>
  main {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    min-height: 100vh;
    position: relative;
    padding: 30px 20px;
  }

  header {
    margin-bottom: 21px;

    @media (width <= 850px) {
      margin-bottom: 11px;
    }
  }

  h1 {
    font-size: 32px;

    @media (width <= 850px) {
      font-size: 22px;
    }
  }

  hr {
    border: 1px solid #000;
    margin-bottom: 21px;

    @media (width <= 850px) {
      margin-bottom: 11px;
    }
  }

  li::after {
    margin-top: 0px;
    margin-bottom: 1px;
    display: block;
    height: 16px;
    content: var(--spaced-dash);
    overflow: hidden;
    letter-spacing: 2px;
    white-space: nowrap;
  }
</style>
